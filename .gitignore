# ---- macOS ----------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ---- Editors / IDEs -------------------------------------------------------
# JetBrains: workspace.xml is per-machine UI state, not project config
.idea/
*.iml
.vscode/
*.swp
*~

# ---- Claude Code ----------------------------------------------------------
# .claude/launch.json IS tracked: it defines how the preview server starts.
# Only the per-machine files below are ignored.
.claude/settings.local.json
.claude/*.local.json

# ---- Python (tools/build_data.py) -----------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/

# ---- Node (only if tooling is added later; the site itself needs none) -----
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Hosting --------------------------------------------------------------
.vercel

# ---- Local env / logs -----------------------------------------------------
.env
.env.*
!.env.example
*.log

# ---- NOT ignored, on purpose ----------------------------------------------
# site/js/data.js is generated by tools/build_data.py, but it must be
# committed: the site has no build step, so GitHub Pages and Vercel serve it
# straight from the repo. Same reasoning applies to site/vendor/ if the CDN
# dependencies are ever vendored locally.
